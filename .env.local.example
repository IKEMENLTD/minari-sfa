# =============================================================================
# 内藤さんシステム (SFA) - 環境変数テンプレート
# このファイルを `.env.local` にコピーして本番値を設定すること。
# Netlify デプロイ時は Site settings → Environment variables で同じものを設定。
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Auth (Phase 1+2 で導入)
# -----------------------------------------------------------------------------
# 共有ログインパスワード(高エントロピー、20文字以上推奨)
SITE_PASSWORD=replace-with-strong-shared-password

# (Optional) HMAC署名鍵を SITE_PASSWORD と分離する場合に設定。
# 未設定なら SITE_PASSWORD が fallback として使われる(後方互換)。
# 推奨: 32バイトのランダム16進文字列
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Claude API (要約生成)
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-your-api-key

# -----------------------------------------------------------------------------
# TLDV API
# -----------------------------------------------------------------------------
TLDV_API_KEY=your-tldv-api-key
TLDV_WEBHOOK_SECRET=your-webhook-shared-secret

# -----------------------------------------------------------------------------
# Netlify Background Function (要約非同期実行)
# -----------------------------------------------------------------------------
# Background Function 呼び出し時の x-background-secret ヘッダ用
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKGROUND_FUNCTION_SECRET=

# -----------------------------------------------------------------------------
# アプリケーション
# -----------------------------------------------------------------------------
# SSR で内部API呼び出し時のベースURL(本番は自動的に Netlify URL が設定される)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 環境
NODE_ENV=development
